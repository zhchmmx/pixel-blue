<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Pixel Blue</vendor>
  <vendor_url>https://github.com/zhchmmx/pixel-blue</vendor_url>

  <!-- Flashing firmware is the single most dangerous action in the image:
       require an explicit admin password for every attempt, never a cached
       authorization.  allow_any=no also keeps remote/inactive sessions out. -->
  <action id="tech.pixelblue.firmware.update">
    <description>安装 Pixelbook 固件更新</description>
    <message>需要管理员身份验证，才能将 MrChromebox UEFI 固件写入本机 SPI flash。</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- Reading the recovery image is not dangerous, but it is device-specific
       firmware: let the active local user authenticate as themselves. -->
  <action id="tech.pixelblue.firmware.export-backup">
    <description>导出 Pixelbook 固件恢复备份</description>
    <message>导出更新前的固件镜像，用于 CH341A/SOIC-8 外部编程器恢复。</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
