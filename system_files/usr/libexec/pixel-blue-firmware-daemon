#!/usr/bin/python3
"""Pixel Blue firmware update service (Issue #69).

D-Bus activated root service behind the GTK updater.  It owns every step of
a MrChromebox UEFI Full ROM update:

    preflight -> backup -> clear software WP -> write -> verify

The dangerous parts are not reimplemented here: they are the vendored
upstream functions from vendor/mrchromebox/functions.sh, executed in a bash
child with the environment they expect (clear_software_wp,
flashrom_write_image).  This daemon only orchestrates them, keeps the failure
marker honest (class A = flash untouched, class B = write started, do NOT
reboot) and holds a logind shutdown:sleep inhibitor for as long as the flash
is being written.  The inhibitor is an open file descriptor, so a daemon
crash releases it automatically instead of leaving the machine unable to
shut down.

The GUI can be a Flatpak: every privileged action goes through this
interface, root never writes to a user's home, and the exported backup is
copied by the GUI with the user's own credentials.

Testability: the PIXEL_BLUE_* environment overrides below point the service
at a fake state directory, DMI/EFI trees, power supply and flashrom stub so
the whole state machine can be driven with busctl inside a VM.
"""

import hashlib
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import threading
import time
import traceback

from gi.repository import Gio, GLib

BUS_NAME = "tech.pixelblue.Firmware1"
OBJECT_PATH = "/tech/pixelblue/Firmware1"
INTERFACE = "tech.pixelblue.Firmware1"

STATE_DIR = os.environ.get("PIXEL_BLUE_FIRMWARE_DIR", "/var/lib/pixel-blue/firmware")
DMI_DIR = os.environ.get("PIXEL_BLUE_DMI_DIR", "/sys/class/dmi/id")
EFI_DIR = os.environ.get("PIXEL_BLUE_EFI_DIR", "/sys/firmware/efi")
POWER_DIR = os.environ.get("PIXEL_BLUE_POWER_DIR", "/sys/class/power_supply")
VENDOR_DIR = os.environ.get("PIXEL_BLUE_VENDOR_DIR", "/usr/lib/pixel-blue/mrchromebox")
CHECK_SCRIPT = os.environ.get("PIXEL_BLUE_CHECK_SCRIPT", "/usr/libexec/firmware-update-check.sh")
INTROSPECTION = os.environ.get("PIXEL_BLUE_INTROSPECTION", "/usr/share/dbus-1/interfaces/tech.pixelblue.Firmware1.xml")
FAKE_FLASHROM = os.environ.get("PIXEL_BLUE_FAKE_FLASHROM", "")
SKIP_INHIBIT = os.environ.get("PIXEL_BLUE_SKIP_INHIBIT") == "1"
SKIP_POLKIT = os.environ.get("PIXEL_BLUE_SKIP_POLKIT") == "1"

BOARD = "eve"
APP_NAME = "pixel-blue-firmware-daemon"
NOTES_URL = "https://docs.mrchromebox.tech/docs/firmware/full-rom.html"

CHECK_JSON = os.path.join(STATE_DIR, "check.json")
BACKUP_ROM = os.path.join(STATE_DIR, "backup.rom")
BACKUP_JSON = os.path.join(STATE_DIR, "backup.json")
EXPORT_DIR = os.path.join(STATE_DIR, "export")
CACHE_DIR = os.path.join(STATE_DIR, "cache")
MARKER = os.path.join(STATE_DIR, "flash-failed")
ATTEMPTS = os.path.join(STATE_DIR, "attempts")
LAST_SUCCESS = os.path.join(STATE_DIR, "last-success")
LAST_FAILURE = os.path.join(STATE_DIR, "last-failure")
NEEDS_REBOOT = os.path.join(STATE_DIR, "needs-reboot")
MRCBX_LOG = os.path.join(STATE_DIR, "mrchromebox.log")

PREFLIGHT_KEYS = ("efi", "board", "bios", "secureboot", "wp_gate", "power")
PREFLIGHT_TTL = 300.0
MIN_CHECK_INTERVAL = 15.0

PROBE_TIMEOUT = 60
READ_TIMEOUT = 300
WP_TIMEOUT = 120
WRITE_TIMEOUT = 900
VERIFY_TIMEOUT = 600
CHECK_TIMEOUT = 900


def log(message):
    print(f"{APP_NAME}: {message}", flush=True)


def read_text(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError:
        return None


def read_json(path):
    text = read_text(path)
    if text is None:
        return {}
    try:
        value = json.loads(text)
    except json.JSONDecodeError:
        return {}
    return value if isinstance(value, dict) else {}


def atomic_write(path, text, mode):
    tmp = f"{path}.tmp.{os.getpid()}.{threading.get_ident()}"
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_json(path, value, mode):
    atomic_write(path, json.dumps(value, indent=2, sort_keys=True) + "\n", mode)


def remove_quiet(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def variant(value):
    if isinstance(value, bool):
        return GLib.Variant("b", value)
    if isinstance(value, int):
        return GLib.Variant("i", value)
    if isinstance(value, dict):
        return GLib.Variant("a{sv}", {str(key): variant(item) for key, item in value.items()})
    return GLib.Variant("s", "" if value is None else str(value))


def ymd_from_dmi(text):
    match = re.match(r"^\s*(\d{1,2})/(\d{1,2})/(\d{4})\s*$", text or "")
    if not match:
        return ""
    month, day, year = (int(part) for part in match.groups())
    return f"{year:04d}{month:02d}{day:02d}"


def text_field(value):
    """JSON null (no update / not downloaded) must never become "None"."""
    return "" if value is None else str(value)


def read_marker():
    """Return the alert-compatible marker fields, or None if absent."""
    text = read_text(MARKER)
    if text is None:
        return None
    fields = {}
    for line in text.splitlines():
        key, sep, value = line.partition("=")
        if sep and key in ("class", "state", "attempts"):
            fields[key] = value.strip()
    fields.setdefault("class", "A")
    fields.setdefault("state", "failed")
    fields.setdefault("attempts", "0")
    return fields


def proc_start_time(pid):
    text = read_text(f"/proc/{pid}/stat")
    if text is None:
        return 0
    # Field 22 (starttime); the command name in parentheses may contain
    # spaces, so count from the last ')'.
    tail = text[text.rfind(")") + 2 :].split()
    try:
        return int(tail[19])
    except (IndexError, ValueError):
        return 0


def which(name):
    for directory in os.environ.get("PATH", "/usr/sbin:/usr/bin:/sbin:/bin").split(os.pathsep):
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return ""


class FirmwareService:
    def __init__(self, connection):
        self.conn = connection
        self.lock = threading.Lock()
        self.busy = False
        self.checking = False
        self.state = "idle"
        self.percent = 0
        self.detail = ""
        self.preflight = {}
        self.preflight_at = 0.0
        self.preflight_running = False
        self.inhibit_fd = None
        self.update_thread = None
        self.check_thread = None
        self.last_check_started = 0.0
        self.write_started = False
        self.flashrom_params = []
        self.flashrom_params_string = ""
        self.flashrom_caps = None
        self.sw_wp = "disabled"
        self.rom_path = ""
        self.rom_sha256 = ""
        os.makedirs(STATE_DIR, exist_ok=True)
        os.makedirs(CACHE_DIR, exist_ok=True)
        os.makedirs(EXPORT_DIR, exist_ok=True)
        if os.geteuid() == 0:
            os.chmod(STATE_DIR, 0o755)

    # --- D-Bus plumbing -----------------------------------------------------

    def emit(self, name, signature, values):
        GLib.idle_add(self._emit_idle, name, signature, values)

    def _emit_idle(self, name, signature, values):
        try:
            self.conn.emit_signal(None, OBJECT_PATH, INTERFACE, name, GLib.Variant(signature, values))
        except GLib.Error as exc:
            log(f"cannot emit {name}: {exc}")
        return False

    def _set_state(self, state, percent, detail):
        with self.lock:
            self.state = state
            self.percent = percent
            self.detail = detail
        self.emit("StateChanged", "(ss)", (state, detail))
        self.emit("ProgressChanged", "(sus)", (state, percent, detail))

    def on_method_call(self, _conn, sender, _path, _iface, method, _parameters, invocation):
        try:
            if method == "GetStatus":
                status = self.get_status()
                invocation.return_value(GLib.Variant("(a{sv})", ({k: variant(v) for k, v in status.items()},)))
            elif method == "CheckNow":
                ok, message = self.check_now()
                invocation.return_value(GLib.Variant("(bs)", (ok, message)))
            elif method == "StartUpdate":
                ok, message = self.start_update(sender)
                invocation.return_value(GLib.Variant("(bs)", (ok, message)))
            elif method == "ExportBackup":
                ok, message = self.export_backup(sender)
                invocation.return_value(GLib.Variant("(bs)", (ok, message)))
            else:
                invocation.return_dbus_error(f"{INTERFACE}.UnknownMethod", f"unknown method {method}")
        except Exception as exc:  # never leave a caller hanging
            traceback.print_exc()
            invocation.return_dbus_error(f"{INTERFACE}.Error", str(exc))

    # --- status -------------------------------------------------------------

    def _installed(self):
        version = (read_text(os.path.join(DMI_DIR, "bios_version")) or "").strip()
        date = ymd_from_dmi(read_text(os.path.join(DMI_DIR, "bios_date")))
        if not date:
            date = text_field(read_json(CHECK_JSON).get("installed_date"))
        return version, date

    def _clear_after_reboot(self):
        remove_quiet(NEEDS_REBOOT)
        remove_quiet(MARKER)
        remove_quiet(ATTEMPTS)
        remove_quiet(LAST_FAILURE)
        log("new firmware booted: cleared needs-reboot marker")

    def _derive_state(self):
        """Return (state, detail, installed_date, available_date, check)."""
        version, installed = self._installed()
        check = read_json(CHECK_JSON)
        available = text_field(check.get("available_date"))
        marker = read_marker()
        if marker is not None:
            klass = "B" if marker["class"] == "B" else "A"
            if marker["state"] == "inprogress":
                return f"failed-class{klass}", "上次写入被中断", installed, available, check
            # the marker only carries class/state/attempts; the human-readable
            # reason (which preflight gate failed, flashrom output) lives here
            failure = read_json(LAST_FAILURE)
            detail = text_field(failure.get("detail")) if failure.get("class", "A") == klass else ""
            return f"failed-class{klass}", detail or "上次更新失败", installed, available, check
        reboot = read_json(NEEDS_REBOOT)
        if reboot:
            target = str(reboot.get("target_date", ""))
            if target and installed and installed >= target:
                self._clear_after_reboot()
            else:
                return "needs-reboot", "固件已写入，重启后生效", installed, available, check
        if available and (not installed or available > installed):
            return "ready", "", installed, available, check
        return "idle", "", installed, available, check

    def _current_preflight(self):
        values = dict(self.preflight)
        for key in PREFLIGHT_KEYS:
            values.setdefault(key, "unknown: 尚未检查")
        return values

    def get_status(self):
        with self.lock:
            busy = self.busy
            checking = self.checking
            if busy:
                state, detail = self.state, self.detail
                version, installed = self._installed()
                check = read_json(CHECK_JSON)
                available = text_field(check.get("available_date"))
            else:
                state, detail, installed, available, check = self._derive_state()
                version = self._installed()[0]
                if checking:
                    state, detail = "checking", "正在检查更新…"
            preflight = self._current_preflight()
            last_success = read_json(LAST_SUCCESS)
            backup = read_json(BACKUP_JSON)
            attempts_text = (read_text(ATTEMPTS) or "0").strip()
            percent = self.percent if busy else 0

        if not busy and not checking and time.monotonic() - self.preflight_at > PREFLIGHT_TTL:
            self._refresh_preflight_async()

        try:
            attempts = int(attempts_text)
        except ValueError:
            attempts = 0

        return {
            "installed_version": version,
            "installed_date": installed,
            "available_version": text_field(check.get("available_version")),
            "available_date": available,
            "release_date": text_field(check.get("release_date")),
            "notes_url": NOTES_URL,
            "rom_file": text_field(check.get("rom_file")),
            "checked_at": int(check.get("checked_at", 0) or 0),
            "state": state,
            "percent": percent,
            "detail": detail,
            "preflight": preflight,
            "backup_present": os.path.isfile(BACKUP_ROM),
            "backup_scope": str(backup.get("scope", "")),
            "attempts": attempts,
            "last_success": str(last_success.get("flashed_at", "")),
            "last_success_version": str(last_success.get("version", "")),
            "last_success_date": str(last_success.get("date", "")),
        }

    # --- update check -------------------------------------------------------

    def check_now(self):
        now = time.monotonic()
        with self.lock:
            if self.busy:
                return False, "固件操作正在进行"
            if self.checking:
                return False, "检查正在进行"
            if now - self.last_check_started < MIN_CHECK_INTERVAL:
                return False, "请稍候再检查"
            self.last_check_started = now
            self.checking = True
        self.emit("StateChanged", "(ss)", ("checking", "正在检查更新…"))
        self.check_thread = threading.Thread(target=self._check_worker, daemon=True)
        self.check_thread.start()
        return True, "已开始检查更新"

    def _check_worker(self):
        try:
            self._run_logged([CHECK_SCRIPT], CHECK_TIMEOUT, self._firmware_env())
        except Exception:
            traceback.print_exc()
        finally:
            with self.lock:
                self.checking = False
            self._emit_state_now()

    def _emit_state_now(self):
        with self.lock:
            if self.checking:
                self.emit("StateChanged", "(ss)", ("checking", "正在检查更新…"))
                return
            state, detail, _, _, _ = self._derive_state()
        self.emit("StateChanged", "(ss)", (state, detail))

    # --- polkit -------------------------------------------------------------

    def _check_polkit(self, sender, action):
        if SKIP_POLKIT:
            return True, ""
        if not sender:
            return False, "无法确认调用者身份"
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            pid_reply = bus.call_sync(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "GetConnectionUnixProcessID",
                GLib.Variant("(s)", (sender,)),
                GLib.VariantType.new("(u)"),
                Gio.DBusCallFlags.NONE,
                5000,
                None,
            )
            pid = int(pid_reply.unpack()[0])
            subject = (
                "unix-process",
                {"pid": GLib.Variant("u", pid), "start-time": GLib.Variant("t", proc_start_time(pid))},
            )
            params = GLib.Variant("((sa{sv})sa{ss}us)", (subject, action, {}, 1, ""))
            reply = bus.call_sync(
                "org.freedesktop.PolicyKit1",
                "/org/freedesktop/PolicyKit1/Authority",
                "org.freedesktop.PolicyKit1.Authority",
                "CheckAuthorization",
                params,
                GLib.VariantType.new("(bba{ss})"),
                Gio.DBusCallFlags.NONE,
                120000,
                None,
            )
            authorized, _challenge, _details = reply.unpack()
        except GLib.Error as exc:
            log(f"polkit check failed: {exc}")
            return False, "无法完成管理员身份验证"
        if authorized:
            return True, ""
        return False, "未授权：需要管理员身份验证"

    # --- update -------------------------------------------------------------

    def start_update(self, sender):
        with self.lock:
            if self.busy:
                return False, "已有固件操作正在进行"
            if self.checking:
                return False, "正在检查更新，请稍候"
        allowed, message = self._check_polkit(sender, "tech.pixelblue.firmware.update")
        if not allowed:
            return False, message

        with self.lock:
            if self.busy:
                return False, "已有固件操作正在进行"
            state, _detail, installed, available, check = self._derive_state()
            if state == "needs-reboot":
                return False, "固件已写入，请先重启"
            if not available or not installed or available <= installed:
                return False, "当前没有可安装的固件更新"
            rom_file = text_field(check.get("rom_file"))
            sha256 = text_field(check.get("sha256"))
            if not check.get("downloaded") or not rom_file or not re.match(r"^[0-9a-f]{64}$", sha256):
                return False, "固件镜像尚未下载完成，请先检查更新"
            rom_path = os.path.join(CACHE_DIR, os.path.basename(rom_file))
            if not os.path.isfile(rom_path):
                return False, "固件镜像文件缺失，请先检查更新"
            self.rom_path = rom_path
            self.rom_sha256 = sha256
            self.busy = True
            self.write_started = False
            self.flashrom_params = []
            self.flashrom_params_string = ""
            self.state = "preflight"
            self.percent = 0
            self.detail = "正在检查安装条件…"
            self.update_thread = threading.Thread(target=self._update_worker, args=(check,), daemon=True)
        self.emit("StateChanged", "(ss)", ("preflight", "正在检查安装条件…"))
        self.emit("ProgressChanged", "(sus)", ("preflight", 0, "正在检查安装条件…"))
        self.update_thread.start()
        return True, ""

    def _update_worker(self, check):
        try:
            attempts = self._increment_attempts()
            self._wait_for_preflight()
            self._set_state("preflight", 2, "正在检查安装条件…")
            preflight = self._preflight_sync()
            self._store_preflight(preflight)
            failures = [value for value in preflight.values() if value.startswith("fail")]
            if failures:
                self._fail("A", "安装条件不满足，固件未改动：" + "；".join(failures))
                return

            self._set_state("backup", 12, "正在备份当前固件…")
            ok, scope = self._backup()
            if not ok:
                self._fail("A", "无法备份当前固件，为避免无法恢复已停止（固件未改动）")
                return
            log(f"firmware backup taken ({scope})")

            self._set_state("writing", 20, "正在写入固件，请勿关机…")
            self._write_marker("B", "inprogress", attempts)
            if not self._acquire_inhibit():
                self._fail(
                    "A",
                    "无法锁定关机/休眠，为避免写入期间被挂起已停止（固件未改动，可安全重启）",
                )
                return
            ok, _out = self._clear_software_wp()
            if not ok:
                self._fail("A", "无法关闭软件写保护，固件未改动（可安全重启）")
                return
            if sha256_file(self.rom_path) != self.rom_sha256:
                self._fail("A", "下载的固件校验失败，固件未改动（可安全重启）")
                return

            self.write_started = True
            self._set_state("writing", 30, "正在写入固件，请勿关机…")
            ok, _out = self._flash()
            if not ok:
                self._fail("B", "固件写入失败或中断。千万不要重启电脑，回到更新器重试。")
                return

            self._set_state("verifying", 85, "正在校验写入结果…")
            ok, _out = self._verify()
            if not ok:
                self._fail("B", "固件写入后校验不通过。千万不要重启电脑，回到更新器重试。")
                return

            self._succeed(text_field(check.get("available_version")), text_field(check.get("available_date")))
        except Exception as exc:
            traceback.print_exc()
            klass = "B" if self.write_started else "A"
            message = f"更新过程中出现内部错误：{exc}"
            if klass == "B":
                message += "。千万不要重启电脑。"
            self._fail(klass, message)

    def _wait_for_preflight(self):
        deadline = time.monotonic() + PROBE_TIMEOUT + 10
        while time.monotonic() < deadline:
            with self.lock:
                if not self.preflight_running:
                    return
            time.sleep(0.2)
        log("preflight refresh still running; continuing with a fresh probe")

    # --- flashrom -----------------------------------------------------------

    def _flashrom_base(self):
        if FAKE_FLASHROM:
            return [FAKE_FLASHROM]
        return [which("flashrom") or "/usr/sbin/flashrom", "-p", "internal:boardmismatch=force"]

    def _caps(self):
        with self.lock:
            cached = self.flashrom_caps
        if cached is not None:
            return cached
        code, output = self._run_logged(self._flashrom_base() + ["-h"], PROBE_TIMEOUT)
        if code != 0:
            raise RuntimeError("flashrom -h failed")
        caps = {
            "noverify": "-N" if "noverify-all" in output else "",
            "ifd": "--ifd" in output,
            "first_chip": "use-first-chip" in output,
        }
        with self.lock:
            self.flashrom_caps = caps
        return caps

    def _flashrom_cmd(self, extra=()):
        """Full flashrom command, mirroring upstream's programmer string."""
        base = self._flashrom_base()
        if not FAKE_FLASHROM and self._caps()["first_chip"]:
            base = base + ["--use-first-chip"]
        return base + list(extra)

    def _run_logged(self, argv, timeout, extra_env=None):
        env = os.environ.copy()
        env["LC_ALL"] = "C"
        if extra_env:
            env.update(extra_env)
        log("+ " + " ".join(shlex.quote(arg) for arg in argv))
        proc = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            env=env,
            bufsize=1,
        )
        timed_out = threading.Event()

        def kill():
            timed_out.set()
            try:
                proc.kill()
            except OSError:
                pass

        timer = threading.Timer(timeout, kill)
        timer.daemon = True
        timer.start()
        lines = []
        try:
            assert proc.stdout is not None
            for line in proc.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                lines.append(line)
            code = proc.wait()
        finally:
            timer.cancel()
        if timed_out.is_set():
            log(f"command timed out after {timeout}s")
            return 124, "".join(lines)
        return code, "".join(lines)

    # --- preflight ----------------------------------------------------------

    def _efi_var_u8(self, name):
        guid = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
        path = os.path.join(EFI_DIR, "efivars", f"{name}-{guid}")
        try:
            with open(path, "rb") as handle:
                data = handle.read(5)
        except OSError:
            return None
        return data[4] if len(data) >= 5 else None

    def _power_ok(self):
        best_battery = None
        try:
            entries = os.listdir(POWER_DIR)
        except OSError:
            return "fail: 无法读取电源状态"
        for entry in entries:
            base = os.path.join(POWER_DIR, entry)
            if entry.startswith(("AC", "ADP")):
                if (read_text(os.path.join(base, "online")) or "").strip() == "1":
                    return "pass"
            if entry.startswith("BAT"):
                value = (read_text(os.path.join(base, "capacity")) or "").strip()
                if value.isdigit():
                    capacity = int(value)
                    best_battery = capacity if best_battery is None else max(best_battery, capacity)
        if best_battery is not None and best_battery >= 50:
            return f"pass: 电池 {best_battery}%（写入期间请保持接通电源）"
        if best_battery is None:
            return "fail: 无法读取电源状态，请接通电源"
        return f"fail: 电量仅 {best_battery}%，请接通电源或充电至 50% 以上"

    def _wp_gate_preflight(self):
        try:
            caps = self._caps()
        except (OSError, RuntimeError):
            return "fail: 找不到可用的 flashrom"
        if not caps["ifd"]:
            return "fail: flashrom 不支持 --ifd 区域写入"
        try:
            _code, probe = self._run_logged(self._flashrom_cmd(), PROBE_TIMEOUT)
        except OSError as exc:
            return f"fail: 无法运行 flashrom（{exc}）"
        lowered = probe.lower()
        if "bios region smm protection is enabled" in lowered:
            return "fail: BIOS Lock / SMM 写保护已开启，请重启进入固件设置关闭 BIOS Lock"
        if "flash chip" not in lowered:
            first = next((line.strip() for line in probe.splitlines() if line.strip()), "无输出")
            return f"fail: flashrom 无法访问 SPI flash（{first}）"

        bash = 'source "$1/functions.sh" || exit 2\nif intel_pr_gpr_locked "$2"; then exit 0; else exit 1; fi\n'
        argv = ["/bin/bash", "-c", bash, "pixel-blue-pr-check", VENDOR_DIR, probe]
        try:
            check = subprocess.run(argv, capture_output=True, text=True, timeout=30, check=False)
        except (OSError, subprocess.TimeoutExpired):
            return "fail: 无法运行上游预检查脚本"
        if check.returncode == 0:
            return "fail: Intel SPI 保护范围（PR0/GPR0）覆盖了 BIOS 区域"
        if check.returncode != 1:
            return "fail: 无法判断 Intel SPI 保护范围"

        code, status = self._run_logged(self._flashrom_cmd(["--wp-status"]), WP_TIMEOUT)
        if code != 0:
            return "fail: 无法读取写保护状态"
        lowered = status.lower()
        match = re.search(r"protection mode:\s*(\w+)", lowered)
        mode = match.group(1) if match else ""
        if mode in ("hardware", "permanent") or "write protect is hardware" in lowered or "permanent" in mode:
            return "fail: 硬件写保护已开启，需要拆机断开 WP 后才能写入"
        if mode == "power_cycle" or "write protect is power cycle" in lowered:
            return "pass: 写保护将在断电后解除（写入前会自动关闭软件写保护）"
        # Upstream treats any remaining "enabled" as software WP and lets
        # clear_software_wp decide: if --wp-disable fails while enabled, the
        # write stage fails closed as class A before touching the flash.
        if "enabled" in lowered:
            return "pass: 软件写保护已开启（写入前会自动关闭）"
        return "pass: 未检测到硬件写保护（写入前会尝试关闭软件写保护）"

    def _preflight_sync(self):
        result = {}

        result["efi"] = "pass" if os.path.isdir(EFI_DIR) else "fail: 未以 UEFI 模式启动"

        board = (read_text(os.path.join(DMI_DIR, "board_name")) or "").strip().lower()
        product = (read_text(os.path.join(DMI_DIR, "product_name")) or "").strip().lower()
        if board == BOARD or product == "pixelbook":
            result["board"] = "pass"
        else:
            result["board"] = f"fail: 本机主板为 {board or product or '未知'}，不是 {BOARD}"

        bios = (read_text(os.path.join(DMI_DIR, "bios_version")) or "").strip()
        if not bios:
            result["bios"] = "fail: 无法读取当前固件版本"
        elif bios.startswith("Google_"):
            result["bios"] = "fail: 当前仍是 Google 原厂固件，不能通过本更新器写入"
        else:
            result["bios"] = "pass"

        secure = self._efi_var_u8("SecureBoot")
        setup = self._efi_var_u8("SetupMode")
        if secure is None:
            result["secureboot"] = "fail: 无法读取 Secure Boot 状态（efivars 不可用）"
        elif secure == 1 and setup != 1:
            result["secureboot"] = "fail: Secure Boot 已开启，请先在固件设置中关闭"
        else:
            result["secureboot"] = "pass"

        result["wp_gate"] = self._wp_gate_preflight()
        result["power"] = self._power_ok()
        return result

    def _store_preflight(self, values):
        with self.lock:
            self.preflight = dict(values)
            self.preflight_at = time.monotonic()

    def _refresh_preflight_async(self):
        with self.lock:
            if self.preflight_running or self.busy or self.checking:
                return
            self.preflight_running = True

        def worker():
            try:
                self._store_preflight(self._preflight_sync())
            except Exception:
                traceback.print_exc()
            finally:
                with self.lock:
                    self.preflight_running = False

        threading.Thread(target=worker, daemon=True).start()

    # --- marker / attempts / inhibit ---------------------------------------

    def _attempts(self):
        text = (read_text(ATTEMPTS) or "0").strip()
        try:
            return max(0, int(text))
        except ValueError:
            return 0

    def _increment_attempts(self):
        with self.lock:
            attempts = self._attempts() + 1
            atomic_write(ATTEMPTS, f"{attempts}\n", 0o644)
        return attempts

    def _write_marker(self, klass, state, attempts):
        atomic_write(MARKER, f"class={klass}\nstate={state}\nattempts={attempts}\n", 0o644)

    def _acquire_inhibit(self):
        """Hold a logind shutdown:sleep lock for the duration of the write.

        Inhibit returns a file descriptor over D-Bus.  call_sync() would drop
        the accompanying UnixFDList and leave only an index, so the fd-list
        variant is used and the returned descriptor is dup'ed into our
        process; the lock lives exactly as long as that fd stays open.
        """
        if SKIP_INHIBIT:
            return True
        with self.lock:
            if self.inhibit_fd is not None:
                return True
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            reply, fd_list = bus.call_with_unix_fd_list_sync(
                "org.freedesktop.login1",
                "/org/freedesktop/login1",
                "org.freedesktop.login1.Manager",
                "Inhibit",
                GLib.Variant(
                    "(ssss)",
                    (
                        "shutdown:sleep",
                        APP_NAME,
                        "正在写入 Pixelbook 固件，中断可能导致无法开机",
                        "block",
                    ),
                ),
                GLib.VariantType.new("(h)"),
                Gio.DBusCallFlags.NONE,
                5000,
                None,
                None,
            )
            if fd_list is None:
                log("logind returned no inhibitor fd")
                return False
            fd = fd_list.get(reply.get_child_value(0).get_handle())
            with self.lock:
                self.inhibit_fd = int(fd)
            log("logind shutdown/sleep inhibitor acquired")
            return True
        except (GLib.Error, TypeError, ValueError, OSError) as exc:
            log(f"cannot acquire logind inhibitor ({exc})")
            return False

    def _release_inhibit(self):
        with self.lock:
            fd = self.inhibit_fd
            self.inhibit_fd = None
        if fd is None:
            return
        try:
            os.close(fd)
            log("logind shutdown/sleep inhibitor released")
        except OSError:
            pass

    # --- backup / write / verify -------------------------------------------

    def _backup(self):
        """Read the current firmware.  The IFD BIOS region is mandatory: it
        determines the write parameters and matches upstream's UEFI path.
        A full-chip dump is kept as well when the chip allows it, because an
        external CH341A restore wants the whole chip.

        A retry must not overwrite the good pre-failure backup with the
        possibly half-written current flash: when backup.json describes the
        firmware that is installed right now and its checksum still matches,
        the existing image is reused.  After a successful flash the recorded
        date no longer matches DMI, so the next update takes a fresh backup.
        """
        self.flashrom_params = ["--ifd", "-i", "bios"]
        self.flashrom_params_string = " ".join(self.flashrom_params)
        version, installed = self._installed()
        previous = read_json(BACKUP_JSON)
        previous_sha = text_field(previous.get("sha256"))
        if (
            os.path.isfile(BACKUP_ROM)
            and text_field(previous.get("installed_version")) == version
            and text_field(previous.get("installed_date")) == installed
            and re.fullmatch(r"[0-9a-f]{64}", previous_sha)
        ):
            try:
                if sha256_file(BACKUP_ROM) == previous_sha:
                    scope = str(previous.get("scope") or "bios-region")
                    log(f"keeping existing {scope} backup for {version} ({installed})")
                    return True, scope
            except OSError as exc:
                log(f"cannot re-check the existing backup ({exc}); reading a new one")

        region_tmp = BACKUP_ROM + ".region"
        remove_quiet(region_tmp)
        code, _out = self._run_logged(self._flashrom_cmd(["--ifd", "-i", "bios", "-r", region_tmp]), READ_TIMEOUT)
        if code != 0 or not os.path.isfile(region_tmp) or os.path.getsize(region_tmp) == 0:
            remove_quiet(region_tmp)
            return False, ""

        full_tmp = BACKUP_ROM + ".full"
        remove_quiet(full_tmp)
        scope = "bios-region"
        keep = region_tmp
        code, _out = self._run_logged(self._flashrom_cmd(["-r", full_tmp]), READ_TIMEOUT)
        if code == 0 and os.path.isfile(full_tmp) and os.path.getsize(full_tmp) > 0:
            scope = "full-chip"
            keep = full_tmp
        else:
            remove_quiet(full_tmp)

        os.replace(keep, BACKUP_ROM)
        os.chmod(BACKUP_ROM, 0o600)
        remove_quiet(region_tmp)
        remove_quiet(full_tmp)
        write_json(
            BACKUP_JSON,
            {
                "scope": scope,
                "installed_version": version,
                "installed_date": installed,
                "sha256": sha256_file(BACKUP_ROM),
                "size": os.path.getsize(BACKUP_ROM),
                "taken_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            },
            0o644,
        )
        return True, scope

    def _clear_software_wp(self):
        _code, status = self._run_logged(self._flashrom_cmd(["--wp-status"]), WP_TIMEOUT)
        # Same classification as upstream functions.sh: "enabled" (or the
        # ChromiumOS "protection mode: hardware" line) means the disable must
        # succeed; otherwise clear_software_wp tolerates the failure.
        if re.search(r"enabled|protection mode:\s*hardware", status, re.IGNORECASE):
            self.sw_wp = "enabled"
        else:
            self.sw_wp = "disabled"
        bash = "\n".join(
            [
                "set -euo pipefail",
                'source "$1/functions.sh"',
                'flashromcmd="$2"',
                'swWp="$3"',
                "clear_software_wp flash",
            ]
        )
        command = " ".join(self._flashrom_cmd())
        if any(re.search(r"\s", arg) for arg in self._flashrom_cmd()):
            raise RuntimeError("flashrom path must not contain whitespace")
        argv = ["/bin/bash", "-c", bash, "pixel-blue-clear-wp", VENDOR_DIR, command, self.sw_wp]
        code, _out = self._run_logged(argv, WP_TIMEOUT, {"MRCBX_LOG": MRCBX_LOG})
        return code == 0, ""

    def _flash(self):
        caps = self._caps()
        command = self._flashrom_cmd()
        if any(re.search(r"\s", arg) for arg in command):
            raise RuntimeError("flashrom path must not contain whitespace")
        bash = "\n".join(
            [
                "set -euo pipefail",
                'source "$1/functions.sh"',
                'flashromcmd="$2"',
                'swWp="$3"',
                'noverify="$4"',
                'flashrom_params="$5"',
                "firmwareType='Full ROM / UEFI'",
                "isChromeOS=false",
                "isChromiumOS=false",
                "isIntel=true",
                'flashrom_write_image "$6" pixel-blue',
            ]
        )
        argv = [
            "/bin/bash",
            "-c",
            bash,
            "pixel-blue-flash",
            VENDOR_DIR,
            " ".join(command),
            self.sw_wp,
            caps["noverify"],
            self.flashrom_params_string,
            self.rom_path,
        ]
        code, _out = self._run_logged(argv, WRITE_TIMEOUT, {"MRCBX_LOG": MRCBX_LOG})
        return code == 0, ""

    def _verify(self):
        code, _out = self._run_logged(self._flashrom_cmd(self.flashrom_params + ["-v", self.rom_path]), VERIFY_TIMEOUT)
        return code == 0, ""

    # --- terminal states ----------------------------------------------------

    def _fail(self, klass, detail):
        attempts = self._attempts()
        try:
            self._write_marker(klass, "failed", attempts)
            write_json(
                LAST_FAILURE,
                {
                    "class": klass,
                    "detail": detail,
                    "attempts": attempts,
                    "failed_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                },
                0o644,
            )
        except OSError:
            traceback.print_exc()
        self._release_inhibit()
        with self.lock:
            self.busy = False
            self.state = f"failed-class{klass}"
            self.percent = 0
            self.detail = detail
        log(f"update failed (class {klass}): {detail}")
        self.emit("UpdateFinished", "(bss)", (False, klass, detail))
        self.emit("StateChanged", "(ss)", (f"failed-class{klass}", detail))

    def _succeed(self, version, target):
        _installed_version, installed = self._installed()
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        write_json(
            LAST_SUCCESS,
            {
                "version": version,
                "date": target,
                "previous_date": installed,
                "sha256": self.rom_sha256,
                "flashed_at": stamp,
            },
            0o644,
        )
        write_json(NEEDS_REBOOT, {"target_date": target, "version": version, "flashed_at": stamp}, 0o644)
        remove_quiet(MARKER)
        remove_quiet(ATTEMPTS)
        remove_quiet(LAST_FAILURE)
        self._release_inhibit()
        message = "固件写入并校验成功，请重启电脑使新固件生效"
        with self.lock:
            self.busy = False
            self.state = "needs-reboot"
            self.percent = 100
            self.detail = message
        log(f"update succeeded: {version} ({target})")
        self.emit("UpdateFinished", "(bss)", (True, "", message))
        self.emit("StateChanged", "(ss)", ("needs-reboot", message))

    # --- backup export ------------------------------------------------------

    def export_backup(self, sender):
        allowed, message = self._check_polkit(sender, "tech.pixelblue.firmware.export-backup")
        if not allowed:
            return False, message
        with self.lock:
            if self.busy:
                return False, "固件操作正在进行，稍后再导出备份"
        if not os.path.isfile(BACKUP_ROM):
            return False, "还没有可导出的固件备份"
        info = read_json(BACKUP_JSON)
        stamp = str(info.get("installed_date", "")) or time.strftime("%Y%m%d")
        target = os.path.join(EXPORT_DIR, f"backup-{stamp}.rom")
        try:
            tmp = target + ".tmp"
            with open(BACKUP_ROM, "rb") as source, open(tmp, "wb") as destination:
                while True:
                    chunk = source.read(1024 * 1024)
                    if not chunk:
                        break
                    destination.write(chunk)
                destination.flush()
                os.fsync(destination.fileno())
            os.chmod(tmp, 0o644)
            os.replace(tmp, target)
        except OSError as exc:
            log(f"backup export failed: {exc}")
            return False, "导出备份失败"
        log(f"backup exported to {target}")
        return True, target

    # --- misc ---------------------------------------------------------------

    def _firmware_env(self):
        return {
            "MRCHROMEBOX_STATE_DIR": STATE_DIR,
            "MRCHROMEBOX_DMI_DIR": DMI_DIR,
            "MRCHROMEBOX_EFI_DIR": EFI_DIR,
            "MRCHROMEBOX_VENDOR_DIR": VENDOR_DIR,
        }

    def shutdown(self):
        self._release_inhibit()


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    loop = GLib.MainLoop()
    state = {"service": None}

    def on_bus_acquired(connection, _name):
        xml = read_text(INTROSPECTION)
        if xml is None:
            log(f"cannot read interface description {INTROSPECTION}")
            loop.quit()
            return
        try:
            node = Gio.DBusNodeInfo.new_for_xml(xml)
        except GLib.Error as exc:
            log(f"invalid interface description: {exc}")
            loop.quit()
            return
        service = FirmwareService(connection)
        state["service"] = service
        try:
            connection.register_object(OBJECT_PATH, node.interfaces[0], service.on_method_call, None, None)
        except GLib.Error as exc:
            log(f"cannot register object: {exc}")
            loop.quit()
            return
        log(f"ready on {BUS_NAME}")

    def on_name_lost(_connection, _name):
        log("lost bus name; exiting")
        loop.quit()

    def on_signal(_signum):
        loop.quit()
        return False

    owner_id = Gio.bus_own_name(
        Gio.BusType.SYSTEM,
        BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        on_bus_acquired,
        None,
        on_name_lost,
    )
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, on_signal, signal.SIGTERM)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, on_signal, signal.SIGINT)
    try:
        loop.run()
    finally:
        service = state["service"]
        if service is not None:
            service.shutdown()
        Gio.bus_unown_name(owner_id)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        traceback.print_exc()
        sys.exit(1)
