# Pixelbook (eve) special keys. keyd only understands key codes 0-255 and
# silently drops larger ones while it holds the device (src/device.c), and
# both keys below natively emit codes above that (KEY_CONTROLPANEL 0x243,
# KEY_ASSISTANT 0x247), so translate them here into codes keyd can bind;
# the actions are assigned in /etc/keyd/cros.conf.
#
# - Three-lines menu key (AT scancode 0x5d, right of volume-up; ChromeOS
#   names it KEY_CONTROLPANEL, atkbd's default keycode for it is F13):
#   -> dashboard (KEY_DASHBOARD, keyd name `dashboard`).
# - Assistant key (AT scancode 0xd8, confirmed via evtest MSC_SCAN):
#   -> F23. F13 was abandoned because GNOME's control-center-static binds
#   F13 (launch Settings) on some distros; F23 has no GNOME default, so
#   bind it to any custom shortcut in Settings -> Keyboard -> Custom
#   Shortcuts.
# The Search/Launcher key is natively leftmeta and needs no remapping.
#
# File is named 70- so it outranks the distro's 60-keyboard.hwdb AND any
# legacy /etc/udev/hwdb.d/61-pixel-keyboard.hwdb preserved on updated
# bootc hosts (records merge in lexicographic order, later file wins per
# property). The compiled hwdb.bin is refreshed at image build time by
# `systemd-hwdb update --usr` in build_files/build.sh.
evdev:atkbd:dmi:bvn*:bvr*:bd*:svnGoogle:pn*:pvr*
 KEYBOARD_KEY_5d=dashboard
 KEYBOARD_KEY_d8=f23
