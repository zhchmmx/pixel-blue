[Unit]
Description=Pixel Blue firmware failure alert and update notifier
After=graphical-session.target
# A missing failure alert can mean a bricked machine, so never give up:
# disable the start rate limit and let Restart=on-failure keep retrying.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/usr/libexec/pixel-blue-flash-alert.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
