[Unit]
Description=Start/stop the ALS brightness daemon from the GNOME automatic brightness toggle
After=graphical-session.target

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/usr/bin/ambient-watch.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
