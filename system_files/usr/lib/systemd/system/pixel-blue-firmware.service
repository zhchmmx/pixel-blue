[Unit]
Description=Pixel Blue firmware update service
Documentation=https://github.com/zhchmmx/pixel-blue
After=dbus.service
# Started on demand by D-Bus (SystemdService= in
# /usr/share/dbus-1/system-services/tech.pixelblue.Firmware1.service).
# Do not enable it: an idle root process is pointless until the updater asks.

[Service]
Type=dbus
BusName=tech.pixelblue.Firmware1
ExecStart=/usr/libexec/pixel-blue-firmware-daemon
Restart=on-failure
RestartSec=5s
StateDirectory=pixel-blue/firmware
StateDirectoryMode=0755

# flashrom needs raw hardware access: /dev/mem, PCI config space and writes
# under /sys/bus/pci/drivers (to unbind spi_intel_platform).  Keep the
# sandbox deliberately shallow: ProtectKernelTunables=yes would break the
# unbind and PrivateDevices=yes would hide the SPI controller entirely.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
PrivateTmp=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
