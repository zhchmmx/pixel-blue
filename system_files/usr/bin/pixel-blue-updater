#!/usr/bin/python3
"""Pixel Blue firmware updater (Issue #69).

Small GTK4 front-end for the D-Bus activated root service
(tech.pixelblue.Firmware1).  It is deliberately unprivileged and talks to the
daemon only through the shared introspection interface, so the same code can
later ship inside a Flatpak: every privileged action (flash, backup export)
goes through polkit in the daemon, and root never writes to the user's home.
The exported recovery image is copied into ~/Downloads by this process with
the user's own credentials.

Live state comes from GetStatus plus StateChanged/ProgressChanged/
UpdateFinished signals, so opening the window in the middle of a flash shows
the real stage and progress.  libadwaita is used when available, but the
window works with plain GTK4 as well.
"""

import os
import shutil
import sys
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

try:
    gi.require_version("Adw", "1")
    from gi.repository import Adw  # noqa: E402
except (ImportError, ValueError):
    Adw = None

BUS_NAME = "tech.pixelblue.Firmware1"
OBJECT_PATH = "/tech/pixelblue/Firmware1"
INTERFACE = "tech.pixelblue.Firmware1"
APP_ID = "tech.pixelblue.Updater"

BUSY_STATES = ("preflight", "backup", "writing", "verifying")
FAILED_STATES = ("failed-classA", "failed-classB")
CHECK_TIMEOUT = 15000
STATUS_TIMEOUT = 15000
AUTH_TIMEOUT = 300000

PREFLIGHT_LABELS = {
    "efi": "UEFI 启动",
    "board": "机型（Eve）",
    "bios": "非 Google 原厂固件",
    "secureboot": "Secure Boot 已关闭",
    "wp_gate": "SPI 写保护可解除",
    "power": "电源充足",
}

CSS = """
.banner-danger { background-color: #a51d2d; color: #ffffff; padding: 12px; border-radius: 8px; }
.banner-warn { background-color: #e5a50a; color: #1a1a1a; padding: 12px; border-radius: 8px; }
.banner-info { background-color: #3584e4; color: #ffffff; padding: 12px; border-radius: 8px; }
.banner-ok { background-color: #26a269; color: #ffffff; padding: 12px; border-radius: 8px; }
.dim { color: #77767b; }
.pass { color: #26a269; }
.fail { color: #c01c28; }
.unknown { color: #77767b; }
.error { color: #c01c28; }
.success { color: #26a269; }
.heading { font-size: 20px; font-weight: bold; }
.subheading { font-size: 14px; font-weight: bold; }
"""


def fmt_date(ymd):
    if isinstance(ymd, str) and len(ymd) == 8 and ymd.isdigit():
        return f"{ymd[0:4]}-{ymd[4:6]}-{ymd[6:8]}"
    return ymd or "未知"


def fmt_stamp(value):
    if not isinstance(value, int) or value <= 0:
        return "从未"
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(value))


def split_preflight(value):
    if not isinstance(value, str) or not value:
        return "尚未检查", "unknown"
    if value.startswith("pass"):
        detail = value.partition(":")[2].strip()
        return detail or "通过", "pass"
    if value.startswith("fail"):
        detail = value.partition(":")[2].strip()
        return detail or "未通过", "fail"
    detail = value.partition(":")[2].strip()
    return detail or "尚未检查", "unknown"


class FirmwareClient:
    """Thin async wrapper around the system-bus interface."""

    def __init__(self, on_signal):
        self.bus = None
        self.inflight = False
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            return
        for name in ("StateChanged", "ProgressChanged", "UpdateFinished"):
            self.bus.signal_subscribe(
                BUS_NAME,
                INTERFACE,
                name,
                OBJECT_PATH,
                None,
                Gio.DBusSignalFlags.NONE,
                lambda *args: on_signal(),
            )

    def available(self):
        return self.bus is not None

    def call(self, method, reply_type, callback, timeout=AUTH_TIMEOUT):
        if self.bus is None:
            callback(False, "系统总线不可用")
            return
        try:
            self.bus.call(
                BUS_NAME,
                OBJECT_PATH,
                INTERFACE,
                method,
                None,
                GLib.VariantType.new(reply_type),
                Gio.DBusCallFlags.NONE,
                timeout,
                None,
                self._on_call,
                callback,
            )
        except GLib.Error as exc:
            callback(False, str(exc))

    @staticmethod
    def _on_call(connection, result, callback):
        try:
            reply = connection.call_finish(result)
        except GLib.Error as exc:
            callback(False, exc.message)
            return
        callback(True, reply.unpack())


class UpdaterView:
    def __init__(self, app):
        self.app = app
        self.status = {}
        self.client = FirmwareClient(self._on_signal)
        self.signal_pending = False
        self.root = self._build()

    # --- construction -------------------------------------------------------

    def _build(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        display = Gdk.Display.get_default()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_vexpand(True)

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.box.set_margin_top(24)
        self.box.set_margin_bottom(24)
        self.box.set_margin_start(24)
        self.box.set_margin_end(24)
        scroller.set_child(self.box)

        self.title_label = Gtk.Label(xalign=0)
        self.title_label.add_css_class("heading")
        self.title_label.set_wrap(True)
        self.box.append(self.title_label)

        self.detail_label = Gtk.Label(xalign=0)
        self.detail_label.set_wrap(True)
        self.detail_label.add_css_class("dim")
        self.box.append(self.detail_label)

        self.banner = Gtk.Label(xalign=0)
        self.banner.set_wrap(True)
        self.banner.set_visible(False)
        self.box.append(self.banner)

        self.info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.info_values = {}
        for key, label in (
            ("firmware", "当前固件"),
            ("available", "可用更新"),
            ("checked", "上次检查"),
            ("backup", "恢复备份"),
        ):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            name = Gtk.Label(label=label, xalign=0)
            name.set_size_request(110, -1)
            name.add_css_class("dim")
            value = Gtk.Label(label="—", xalign=0)
            value.set_wrap(True)
            value.set_hexpand(True)
            row.append(name)
            row.append(value)
            self.info_box.append(row)
            self.info_values[key] = value
        self.box.append(self.info_box)

        self.progress = Gtk.ProgressBar()
        self.progress.set_visible(False)
        self.box.append(self.progress)

        self.preflight_title = Gtk.Label(label="安装条件", xalign=0)
        self.preflight_title.add_css_class("subheading")
        self.box.append(self.preflight_title)

        self.preflight_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.preflight_values = {}
        for key, label in PREFLIGHT_LABELS.items():
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            name = Gtk.Label(label=label, xalign=0)
            name.set_size_request(170, -1)
            name.add_css_class("dim")
            value = Gtk.Label(label="尚未检查", xalign=0)
            value.set_wrap(True)
            value.set_hexpand(True)
            row.append(name)
            row.append(value)
            self.preflight_box.append(row)
            self.preflight_values[key] = value
        self.box.append(self.preflight_box)

        self.notes_button = Gtk.LinkButton(uri="", label="查看 MrChromebox 更新说明")
        self.notes_button.set_halign(Gtk.Align.START)
        self.notes_button.set_visible(False)
        self.box.append(self.notes_button)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        actions.set_margin_top(6)
        self.check_button = Gtk.Button(label="检查更新")
        self.check_button.connect("clicked", self._on_check)
        self.install_button = Gtk.Button(label="安装更新")
        self.install_button.add_css_class("suggested-action")
        self.install_button.connect("clicked", self._on_install)
        self.export_button = Gtk.Button(label="导出恢复备份")
        self.export_button.connect("clicked", self._on_export)
        self.reboot_button = Gtk.Button(label="立即重启")
        self.reboot_button.connect("clicked", self._on_reboot)
        for button in (self.check_button, self.install_button, self.export_button, self.reboot_button):
            actions.append(button)
        self.box.append(actions)

        self.message_label = Gtk.Label(xalign=0)
        self.message_label.set_wrap(True)
        self.message_label.set_visible(False)
        self.box.append(self.message_label)

        self.recovery = Gtk.Expander(label="无法开机时的恢复步骤（CH341A / SOIC-8）")
        recovery_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        recovery_box.set_margin_top(8)
        self.recovery_text = Gtk.Label(xalign=0)
        self.recovery_text.set_wrap(True)
        self.recovery_text.set_selectable(True)
        recovery_box.append(self.recovery_text)
        self.recovery.set_child(recovery_box)
        self.recovery.set_visible(False)
        self.box.append(self.recovery)

        self.debug = Gtk.Expander(label="排查与手动兜底")
        debug_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        debug_box.set_margin_top(8)
        for text in (
            "systemd 日志：journalctl -u pixel-blue-firmware.service -b",
            "失败标记：sudo cat /var/lib/pixel-blue/firmware/flash-failed",
            "可用版本：/usr/lib/pixel-blue/mrchromebox/download-fullrom.sh --list-versions",
            "手动下载：/usr/lib/pixel-blue/mrchromebox/download-fullrom.sh -o ~/Downloads eve（会自行获取上游元数据）",
            "上游交互式工具（需要时手动下载）："
            " https://raw.githubusercontent.com/MrChromebox/scripts/main/firmware-util.sh",
        ):
            label = Gtk.Label(label=text, xalign=0)
            label.set_wrap(True)
            label.set_selectable(True)
            debug_box.append(label)
        self.debug.set_child(debug_box)
        self.box.append(self.debug)

        GLib.timeout_add(1000, self._poll)
        self.refresh()
        return scroller

    # --- polling / signals --------------------------------------------------

    def _poll(self):
        self.refresh()
        return True

    def _on_signal(self):
        if self.signal_pending:
            return
        self.signal_pending = True
        GLib.idle_add(self._run_signal_refresh)

    def _run_signal_refresh(self):
        self.signal_pending = False
        self.refresh()
        return False

    def refresh(self):
        if not self.client.available():
            self._show_offline("系统总线不可用，无法连接固件服务。")
            return
        if self.client.inflight:
            return
        self.client.inflight = True
        self.client.call("GetStatus", "(a{sv})", self._on_status, STATUS_TIMEOUT)

    def _on_status(self, ok, payload):
        self.client.inflight = False
        if not ok:
            self._show_offline(f"无法连接固件服务：{payload}")
            return
        try:
            status = payload[0]
        except (IndexError, TypeError):
            self._show_offline("固件服务返回了无法识别的数据。")
            return
        if isinstance(status, dict):
            self.apply(status)
        else:
            self._show_offline("固件服务返回了无法识别的数据。")

    def _show_offline(self, detail):
        self.title_label.set_text("固件服务不可用")
        self.detail_label.set_text(detail)
        self._set_banner("", "")
        self.progress.set_visible(False)
        self.preflight_box.set_visible(False)
        self.preflight_title.set_visible(False)
        self.install_button.set_visible(False)
        self.export_button.set_visible(False)
        self.reboot_button.set_visible(False)
        self.recovery.set_visible(False)
        self.notes_button.set_visible(False)
        self.check_button.set_visible(True)
        self.check_button.set_sensitive(True)

    # --- rendering ----------------------------------------------------------

    def apply(self, status):
        self.status = status
        state = status.get("state", "idle")
        busy = state in BUSY_STATES
        failed = state in FAILED_STATES
        available = status.get("available_date") or ""
        installed = status.get("installed_date") or ""
        version = status.get("installed_version") or "未知"
        available_version = status.get("available_version") or ""

        titles = {
            "idle": "固件已是最新",
            "ready": "发现固件更新",
            "checking": "正在检查更新…",
            "preflight": "正在检查安装条件…",
            "backup": "正在备份当前固件…",
            "writing": "正在写入固件…",
            "verifying": "正在校验固件…",
            "failed-classA": "固件更新失败（可安全重启）",
            "failed-classB": "固件更新失败——千万不要重启",
            "needs-reboot": "固件已写入，请重启",
        }
        self.title_label.set_text(titles.get(state, "Pixelbook 固件更新"))

        detail = status.get("detail") or ""
        if state == "idle":
            if installed:
                detail = f"当前固件 {version}（{fmt_date(installed)}）为最新版本。"
            else:
                detail = f"当前固件 {version}。"
        elif state == "ready":
            detail = f"可用版本 {available_version}（{fmt_date(available)}）。安装需要管理员验证。"
        elif state == "failed-classA":
            detail = (status.get("detail") or "") + " 写入尚未开始，固件未被修改，重启是安全的。"
        elif state == "failed-classB":
            detail = (status.get("detail") or "") + " 固件可能不完整。请保持开机，然后重试更新。"
        self.detail_label.set_text(detail)

        self.info_values["firmware"].set_text(f"{version}（{fmt_date(installed)}）")
        if available_version:
            self.info_values["available"].set_text(f"{available_version}（{fmt_date(available)}）")
        else:
            self.info_values["available"].set_text("无")
        self.info_values["checked"].set_text(fmt_stamp(status.get("checked_at")))
        if status.get("backup_present"):
            scope = status.get("backup_scope") or ""
            scope_text = "整片备份" if scope == "full-chip" else "BIOS 区域备份"
            self.info_values["backup"].set_text(f"已就绪（{scope_text}）")
        else:
            self.info_values["backup"].set_text("尚无备份")

        self._render_banner(state, status)
        self._render_preflight(status.get("preflight") or {})
        self._render_progress(state, status)
        self._render_buttons(state, status, busy, failed)

        notes = status.get("notes_url") or ""
        self.notes_button.set_visible(bool(notes) and not busy)
        if notes:
            self.notes_button.set_uri(notes)
            self.notes_button.set_label("查看 MrChromebox 固件说明")

        if state == "failed-classB":
            self.recovery.set_visible(True)
            self._render_recovery(status)
        else:
            self.recovery.set_visible(False)

    def _set_banner(self, text, kind):
        if not text:
            self.banner.set_visible(False)
            return
        self.banner.set_text(text)
        self.banner.set_visible(True)
        for name in ("banner-danger", "banner-warn", "banner-info", "banner-ok"):
            self.banner.remove_css_class(name)
        self.banner.add_css_class(kind)

    def _render_banner(self, state, status):
        if state in ("writing", "verifying"):
            self._set_banner("正在写入固件：请勿关机、休眠或断电。", "banner-danger")
        elif state == "failed-classB":
            self._set_banner(
                "千万不要重启或断电！固件可能不完整。关机与挂起已被临时禁止，直到重试成功。",
                "banner-danger",
            )
        elif state == "failed-classA":
            self._set_banner("写入尚未开始，固件完好，重启或关机都是安全的。", "banner-warn")
        elif state in ("preflight", "backup"):
            self._set_banner("正在准备，请保持接通电源。", "banner-info")
        elif state == "needs-reboot":
            self._set_banner("固件已写入并通过校验，请重启电脑使其生效。", "banner-ok")
        elif state == "checking":
            self._set_banner("正在联网检查 MrChromebox 发布的最新版本。", "banner-info")
        else:
            self._set_banner("", "")

    def _render_preflight(self, preflight):
        show = bool(preflight) and self.status.get("state") in (
            "ready",
            "failed-classA",
            "failed-classB",
            "needs-reboot",
        )
        self.preflight_title.set_visible(show)
        self.preflight_box.set_visible(show)
        if not show:
            return
        for key, widget in self.preflight_values.items():
            text, kind = split_preflight(preflight.get(key))
            widget.set_text(text)
            for name in ("pass", "fail", "unknown"):
                widget.remove_css_class(name)
            widget.add_css_class(kind)

    def _render_progress(self, state, status):
        if state in ("checking", "preflight", "backup", "writing", "verifying"):
            self.progress.set_visible(True)
            if state == "checking":
                self.progress.pulse()
            else:
                percent = status.get("percent") or 0
                try:
                    fraction = max(0.0, min(1.0, float(percent) / 100.0))
                except (TypeError, ValueError):
                    fraction = 0.0
                self.progress.set_fraction(fraction)
        else:
            self.progress.set_visible(False)

    def _preflight_all_pass(self):
        preflight = self.status.get("preflight") or {}
        if not preflight:
            return False
        return all(str(value).startswith("pass") for value in preflight.values())

    def _render_buttons(self, state, status, busy, failed):
        self.check_button.set_visible(state not in ("needs-reboot",))
        self.check_button.set_sensitive(not busy and state != "checking")

        show_install = state == "ready" or failed
        self.install_button.set_visible(show_install)
        self.install_button.set_label("重试更新" if failed else "安装更新")
        self.install_button.set_sensitive(show_install and not busy and self._preflight_all_pass())

        self.export_button.set_visible(bool(status.get("backup_present")) and not busy)
        self.export_button.set_sensitive(not busy)

        self.reboot_button.set_visible(state == "needs-reboot")
        self.reboot_button.set_sensitive(state == "needs-reboot")

    def _render_recovery(self, status):
        installed = fmt_date(status.get("installed_date"))
        backup_name = f"backup-{installed.replace('-', '')}.rom" if installed != "未知" else "backup.rom"
        scope = status.get("backup_scope") or ""
        if scope == "full-chip":
            steps = f"4. 写入整片备份并校验：flashrom -p ch341a_spi -w {backup_name} -v\n"
        else:
            steps = (
                "4. 本次备份只包含 BIOS 区域。写入时保留芯片上的原厂 IFD 布局："
                f"flashrom -p ch341a_spi --ifd -i bios -w {backup_name} -v\n"
                "   如果 flashrom 读不出 IFD，说明备份与整片不匹配，"
                "请改用 MrChromebox 的固件包做整片恢复。\n"
            )
        self.recovery_text.set_text(
            "只有在完全无法开机时才需要这样做。不要使用 ChromeOS 的 SuzyQ/CCD 恢复模式："
            "这台机器运行的是 MrChromebox UEFI Full ROM，ChromeOS 恢复镜像不适用。\n\n"
            "1. 完全关机，拔掉电源和电池排线。\n"
            "2. 拆下底盖，用 SOIC-8 测试夹夹住主板上的 SPI flash 芯片"
            "（16 MB，W25Q128 系列；夹子方向以 1 脚圆点为基准）。\n"
            "3. 在另一台 Linux 电脑上连接 CH341A 编程器，先读一次确认连接："
            " flashrom -p ch341a_spi -r readback.rom\n" + steps + "5. 装回电池、接上电源，首次开机会较慢。\n\n"
            f"备份文件：先点「导出恢复备份」，它会保存到下载目录（{backup_name}）。"
        )

    # --- actions ------------------------------------------------------------

    def _show_message(self, text, kind):
        if not text:
            self.message_label.set_visible(False)
            return
        self.message_label.set_text(text)
        self.message_label.set_visible(True)
        for name in ("error", "success", "dim"):
            self.message_label.remove_css_class(name)
        self.message_label.add_css_class(kind)

    def _on_check(self, _button):
        self._show_message("")
        self.check_button.set_sensitive(False)
        self.client.call("CheckNow", "(bs)", self._on_started, CHECK_TIMEOUT)

    def _on_install(self, _button):
        self._show_message("")
        self.install_button.set_sensitive(False)
        self._show_message("等待管理员验证…", "dim")
        self.client.call("StartUpdate", "(bs)", self._on_started)

    def _on_started(self, ok, payload):
        if not ok:
            self._show_message(f"操作失败：{payload}", "error")
            self.refresh()
            return
        try:
            started, message = payload
        except (TypeError, ValueError):
            self._show_message("固件服务返回了无法识别的数据。", "error")
            self.refresh()
            return
        if not started:
            self._show_message(message or "操作未开始。", "error")
        else:
            self._show_message(message or "已开始。", "dim")
        self.refresh()

    def _on_export(self, _button):
        self._show_message("")
        self.export_button.set_sensitive(False)
        self.client.call("ExportBackup", "(bs)", self._on_export_done)

    def _on_export_done(self, ok, payload):
        if not ok:
            self._show_message(f"导出失败：{payload}", "error")
            self.refresh()
            return
        try:
            success, path = payload
        except (TypeError, ValueError):
            self._show_message("固件服务返回了无法识别的数据。", "error")
            self.refresh()
            return
        if not success:
            self._show_message(path or "导出失败。", "error")
            self.refresh()
            return
        copied = self._copy_to_downloads(path)
        if copied:
            self._show_message(f"恢复备份已保存到 {copied}", "success")
        else:
            self._show_message(f"备份已生成于 {path}，但复制到下载目录失败。", "error")
        self.refresh()

    def _copy_to_downloads(self, source):
        downloads = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
        if not downloads:
            downloads = os.path.expanduser("~")
        try:
            os.makedirs(downloads, exist_ok=True)
            name = os.path.basename(source)
            target = os.path.join(downloads, name)
            index = 1
            while os.path.exists(target):
                stem, suffix = os.path.splitext(name)
                target = os.path.join(downloads, f"{stem}-{index}{suffix}")
                index += 1
            shutil.copyfile(source, target)
            os.chmod(target, 0o644)
            return target
        except OSError as exc:
            print(f"pixel-blue-updater: cannot copy backup: {exc}", file=sys.stderr)
            return ""

    def _on_reboot(self, _button):
        try:
            Gio.Subprocess.new(
                ["gnome-session-quit", "--reboot", "--no-prompt"],
                Gio.SubprocessFlags.NONE,
            )
        except GLib.Error as exc:
            self._show_message(f"无法发起重启：{exc}", "error")


def main():
    AppBase = Adw.Application if Adw is not None else Gtk.Application
    WindowBase = Adw.ApplicationWindow if Adw is not None else Gtk.ApplicationWindow

    class UpdaterApp(AppBase):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
            self.window = None
            self.view = None
            action = Gio.SimpleAction.new("open", None)
            action.connect("activate", lambda *_args: self.show_window())
            self.add_action(action)

        def do_activate(self):
            self.show_window()

        def show_window(self):
            if self.window is None:
                self.window = WindowBase(application=self, title="Pixelbook 固件更新")
                self.window.set_default_size(760, 720)
                self.view = UpdaterView(self)
                self.window.set_child(self.view.root)
                self.window.connect("close-request", self._on_close)
            self.window.present()

        def _on_close(self, _window):
            self.window = None
            self.view = None
            return False

    app = UpdaterApp()
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
