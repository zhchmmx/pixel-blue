# Google Pixelbook (eve) built-in Wacom AES digitizer
# libwacom device entry so that GNOME recognizes the Pixelbook Pen.
# VID:PID verified from this machine's sysfs HID device:
#   /sys/bus/hid/devices/0018:2D1F:5143.0001  (bus 0018 = I2C, VID 2D1F = Wacom embedded)
[Device]
Name=Google Pixelbook (eve) Digitizer
ModelName=Pixelbook
DeviceMatch=i2c:2d1f:5143
Class=ISDV4
Width=10
Height=7
IntegratedIn=Display;System
Styli=isdv4-aes

[Features]
Stylus=true
Touch=false
