# Google Pixelbook (eve) built-in Wacom AES digitizer (HID over I2C)
# libwacom entry so GNOME recognizes the Pixelbook Pen and stops showing
# "unknown device / may present wrong capabilities".
# VID:PID verified from this machine's sysfs: /sys/bus/hid/devices/0018:2D1F:5143.0001
[Device]
Name=Google Pixelbook
ModelName=Pixelbook
DeviceMatch=i2c|2d1f|5143
Class=ISDV4
Width=259
Height=172
IntegratedIn=Display;System
# Bind the Pixelbook Pen stylus (see google-eve.stylus). GNOME's Wacom
# panel picks the first supported stylus for serial-less pens, so this
# controls which pen name appears in Settings.
Styli=0x4fca;

[Features]
Stylus=true
Touch=true
