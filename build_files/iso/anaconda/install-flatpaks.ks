%post --erroronfail --nochroot --interpreter=/usr/bin/bash --log=/tmp/install-flatpaks.log
set -euxo pipefail

# The live image already carries the Flathub apps in /var/lib/flatpak (the
# ISO layer installs them from flatpak_refs/). Copy that system installation
# into the target so first boot has the preinstalled apps without downloading
# them again.
#
# The target is the stateroot's var (/ostree/deploy/<stateroot>/var), NOT the
# deployment checkout's <rev>.<serial>/var: at runtime /var is a bind mount of
# the stateroot var (the var.mount unit generated by ostree's system
# generator), so anything written into the checkout tree is hidden by that
# mount on first boot. The stateroot var is also the state that survives
# upgrades, which is where a system flatpak store belongs.
#
# Derive the stateroot from the origins of the real deployments instead of
# hardcoding ostree/0/1/0, the .0 serial, or the stateroot name; fail loudly
# when the expected layout is missing instead of rsyncing into a dead path.
if [ ! -d /var/lib/flatpak ]; then
  echo "error: /var/lib/flatpak missing from the live image" >&2
  exit 1
fi

mapfile -t origins < <(
  find /mnt/sysimage/ostree/deploy -path '*/deploy/*.origin' -type f
)
if [ "${#origins[@]}" -eq 0 ]; then
  echo "error: no ostree deployment found under /mnt/sysimage/ostree/deploy" >&2
  exit 1
fi

declare -A copied=()
for origin in "${origins[@]}"; do
  # Origins sit next to their deployment directory (<rev>.<serial>.origin),
  # and the stateroot var is two levels up from the deployment dir's parent.
  deploydir="$(dirname "$origin")/$(basename "$origin" .origin)"
  stateroot_var="$(dirname "$(dirname "$origin")")/var"
  if [ -n "${copied["$stateroot_var"]+x}" ]; then
    continue
  fi
  if [ ! -d "$deploydir" ]; then
    echo "error: deployment directory $deploydir is missing" >&2
    exit 1
  fi
  if [ ! -d "$stateroot_var" ]; then
    echo "error: stateroot var $stateroot_var is missing" >&2
    exit 1
  fi
  copied["$stateroot_var"]=1

  mkdir -p "$stateroot_var/lib"
  # The live store was created in the ISO build container (label=disable),
  # so drop whatever security.selinux it carries and relabel below.
  rsync -aAXUHKP --filter='-x security.selinux' /var/lib/flatpak "$stateroot_var/lib/"
  if [ ! -d "$stateroot_var/lib/flatpak/repo" ]; then
    echo "error: flatpak system store missing after copy into $stateroot_var" >&2
    exit 1
  fi

  # file_contexts patterns match literal path strings (everything under
  # /mnt/<host>/... is <<none>>), so relabel with setfiles -r using the
  # stateroot as alternate root: the walked paths are then matched as
  # /var/lib/... against the installed policy's file_contexts. A
  # plain restorecon of the /mnt/sysimage path would be a silent no-op and
  # leave the store unlabeled on the enforcing target (restorecon's -r flag
  # is plain recursion; only setfiles takes an alternate root).
  #
  # setfiles in libselinux 3.11 (Fedora 44) does not canonicalize its
  # pathname arguments and refuses to follow symlinks in the path
  # (O_NOFOLLOW|O_DIRECTORY yields ENOTDIR, logged as "open(...): Not a
  # directory"). bootc images expose the sysroot through the historical
  # /ostree -> sysroot/ostree compatibility symlink, and find reports the
  # /mnt/sysimage/ostree/... path, so canonicalize the stateroot root
  # before relabeling. Upstream defaulted setfiles to
  # SELINUX_RESTORECON_REALPATH instead (SELinuxProject/selinux#540);
  # realpath is a no-op when there is no symlink.
  selinuxtype="$(sed -n 's/^SELINUXTYPE=//p' "$deploydir/etc/selinux/config" | head -n1)"
  file_contexts="$deploydir/etc/selinux/${selinuxtype:-targeted}/contexts/files/file_contexts"
  if [ ! -f "$file_contexts" ]; then
    echo "error: $file_contexts missing from the installed system" >&2
    exit 1
  fi
  stateroot_root="$(realpath "$(dirname "$stateroot_var")")"
  image_root="$(realpath /mnt/sysimage)"
  if [ "${stateroot_root#"$image_root"/}" = "$stateroot_root" ]; then
    echo "error: stateroot $stateroot_root resolved outside $image_root" >&2
    exit 1
  fi
  # setfiles matches the pathname it is given against file_contexts, so
  # var/lib must stay real directories under the canonical root; resolving
  # a symlinked var/lib would change the /var/lib path it looks up.
  if [ "$(realpath "$stateroot_var/lib")" != "$stateroot_root/var/lib" ]; then
    echo "error: $stateroot_var/lib is not a plain directory under $stateroot_root" >&2
    exit 1
  fi
  setfiles -F -r "$stateroot_root" "$file_contexts" "$stateroot_root/var/lib"

  sync
done
%end
