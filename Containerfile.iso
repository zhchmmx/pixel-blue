# Live/installer layer for the Pixel Blue ISO.
#
# This image is a thin layer on top of the published Pixel Blue image. It is
# the rootfs of the ISO's live system and the environment Anaconda runs in; it
# is never pushed, and the published image stays the single source of truth
# for the installed system.
#
# It is consumed by osbuild image-builder as the `bootc-generic-iso` input:
#
#   image-builder build \
#     --bootc-ref localhost/pixel-blue-iso:latest \
#     --bootc-installer-payload-ref ghcr.io/zhchmmx/pixel-blue:latest \
#     bootc-generic-iso
#
# The install payload is NOT baked in here: image-builder copies it out of the
# host's rootful container storage into /var/lib/containers/storage inside the
# squashfs (that is what --bootc-installer-payload-ref does), which keeps this
# layer free of nested podman.
#
# Build with:
#   sudo podman build \
#     --cap-add sys_admin --security-opt label=disable \
#     --build-arg BASE_IMAGE=ghcr.io/zhchmmx/pixel-blue:latest \
#     --build-arg PAYLOAD_IMAGE=ghcr.io/zhchmmx/pixel-blue:latest \
#     --tag localhost/pixel-blue-iso:latest --file Containerfile.iso .
#
# The extra capabilities are required because the script installs Flatpaks
# inside the build (bwrap needs a writable /proc/sys). `just build-iso` (or the
# Build disk images workflow) does this and then hands the image to
# image-builder.

ARG BASE_IMAGE=ghcr.io/zhchmmx/pixel-blue:latest

FROM scratch AS ctx
COPY build_files/iso /iso
COPY flatpak_refs /flatpak_refs
COPY system_files/etc/containers /containers

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG PAYLOAD_IMAGE
RUN --mount=type=bind,from=ctx,source=/iso,target=/ctx/iso \
    --mount=type=bind,from=ctx,source=/flatpak_refs,target=/ctx/flatpak_refs \
    --mount=type=bind,from=ctx,source=/containers,target=/ctx/containers \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    BASE_IMAGE="${BASE_IMAGE}" \
    PAYLOAD_IMAGE="${PAYLOAD_IMAGE:-${BASE_IMAGE}}" \
    /ctx/iso/build.sh
