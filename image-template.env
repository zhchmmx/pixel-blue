# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=pixel-blue

# Make this the same as your github username/organisation
REPO_ORGANIZATION="zhchmmx"

IMAGE_DESC="Pixel Blue is a Universal Blue image for Pixelbook users."
IMAGE_KEYWORDS="bootc,oci,linux,fedora,silverblue,pixelbook"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/zhchmmx/pixel-blue/refs/heads/main/pixel-blue.png"
DEFAULT_TAG="latest"

# Fedora release the installer environment is built from; keep in step with
# the payload image.
FEDORA_VERSION="44"

# Disk image builder (qcow2/raw).
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# ISO builder: lorax, run inside a fedora:<VERSION> container by
# iso/build-iso.sh. lorax is what Fedora and RHEL use to produce boot.iso, so
# the installer environment (Anaconda, SELinux contexts, logind ReserveVT, the
# dracut modules) is maintained upstream instead of here. The script adds only
# what is ours: the payload OCI layout, the Flatpak repo, the Anaconda profile.
# No pinned version here -- the lorax release follows the container image named
# in build-disk.yml.
