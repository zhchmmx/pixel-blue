# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=pixel-blue

# Make this the same as your github username/organisation
REPO_ORGANIZATION="zhchmmx"

IMAGE_DESC="Pixel Blue is a Universal Blue image for Pixelbook users."
IMAGE_KEYWORDS="bootc,oci,linux,fedora,silverblue,pixelbook"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/zhchmmx/pixel-blue/refs/heads/main/pixel-blue.png"
DEFAULT_TAG="latest"

BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# ublue-os/titanoboa commit used for local ISO builds (just build-iso).
# Keep in sync with the SHA pinned for ublue-os/titanoboa in
# .github/workflows/build-disk.yml.
TITANOBOA_SHA="5c457c3d0518bd17e754be0fd98a60d29d26abb4"
