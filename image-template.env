# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=pixel-blue

# Make this the same as your github username/organisation
REPO_ORGANIZATION="zhchmmx"

IMAGE_DESC="Pixel Blue is a Universal Blue image for Pixelbook users."
IMAGE_KEYWORDS="bootc,oci,linux,fedora,silverblue,pixelbook"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/zhchmmx/pixel-blue/refs/heads/main/pixel-blue.png"
DEFAULT_TAG="latest"

# Disk image builder (qcow2/raw). Still bootc-image-builder for now; it is
# being merged into image-builder (see IMAGE_BUILDER_IMAGE below) and this
# will disappear once the qcow2/raw recipes move over too.
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# ISO builder: the unified osbuild image-builder CLI (osbuild/image-builder,
# container ghcr.io/osbuild/image-builder-cli). It superseded both
# ublue-os/titanoboa and the standalone bootc-image-builder. The ISO uses the
# `bootc-generic-iso` type: Anaconda runs from Containerfile.installer, the
# published image is embedded as the install payload, and the GRUB menu plus
# the kernel command line come from build_files/installer/iso.yaml. (The older
# `bootc-installer` type hardcoded `inst.text` in its command line, which is
# why the installer used to be a TUI and installed unattended.)
# Still on :latest: build-disk.yml prints the digest it resolved, so pin that
# digest here once the pipeline is proven.
IMAGE_BUILDER_IMAGE="ghcr.io/osbuild/image-builder-cli:latest"
