# Anaconda installer image for the Pixel Blue ISO.
#
# image-builder turns this container into the ISO (bootc-generic-iso): the
# squashfs the installer boots into, plus a copy of the payload container in
# its storage. There is no live desktop here -- this image exists only to run
# Anaconda.
#
#   image-builder build \
#     --bootc-ref localhost/pixel-blue-installer:latest \
#     --bootc-installer-payload-ref localhost/pixel-blue-payload:latest \
#     bootc-generic-iso
#
# Responsibilities, in the order they appear below:
#   * Anaconda running the Web UI on a kiosk compositor
#   * the ISO's GRUB menu and kernel command line            (iso.yaml)
#   * what gets installed and how it boots afterwards        (interactive-defaults.ks)
#   * /flatpak/repo, the offline Flatpak source Anaconda installs during the run
#   * the glue that lets Anaconda start at all from a container (the lorax part)
#
# Build with:
#   sudo podman build --cap-add sys_admin --security-opt label=disable \
#     --tag localhost/pixel-blue-installer:latest --file Containerfile.installer .
#
# The extra capabilities are for the Flatpak install below (bwrap wants a
# writable /proc/sys).

ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:latest

# Both are baked into interactive-defaults.ks. They are separate because the
# source is a local copy in the installer's own container storage (stripped of
# signatures, see build-disk.yml) while the target is the published reference
# the installed system follows for updates.
ARG PAYLOAD_SRC_REF=ghcr.io/zhchmmx/pixel-blue:latest
ARG PAYLOAD_TARGET_REF=ghcr.io/zhchmmx/pixel-blue:latest

FROM ${BASE_IMAGE}

ARG PAYLOAD_SRC_REF
ARG PAYLOAD_TARGET_REF

# anaconda-install-img-deps is the dependency set for installing *from* an
# image. It brings anaconda-core, gnome-kiosk, the anaconda-shell@ unit, the
# logind ReserveVT drop-in and mesa-dri-drivers -- Anaconda draws its UI inside
# that kiosk session, so without this package there is a backend and a blank
# screen. anaconda-webui is the frontend and slitherer the browser it renders
# in; firefox is the fallback the launcher knows about.
#
# xorriso/isomd5sum/grub2-tools/jq are bootc-generic-iso's own requirements
# (xorrisofs, implantisomd5, grub2-mkimage, and the kernel-install JSON parsing
# below). The fonts, plymouth and GPU firmware are what a graphical installer
# needs to draw anything on real hardware.
RUN dnf install -y \
      anaconda-install-img-deps \
      anaconda-webui \
      slitherer \
      firefox \
      anaconda-dracut \
      dracut-config-generic \
      dracut-network \
      biosdevname \
      prefixdevname \
      net-tools \
      plymouth \
      default-fonts-core-sans \
      default-fonts-other-sans \
      google-noto-sans-cjk-fonts \
      linux-firmware \
      intel-gpu-firmware \
      mesa-dri-drivers \
      flatpak \
      flatpak-libs \
      xorriso \
      isomd5sum \
      grub2-tools \
      grub2-efi-x64-cdboot \
      'lorax-templates-*' \
      python3-mako \
      squashfs-tools \
      jq \
 && dnf clean all

# lorax wants a symlink in /mnt pointing at /var/mnt, which bootc images do not
# ship.
RUN mkdir -p /var/mnt

# The ISO's ESP is assembled from here.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# --- Flatpak source ---------------------------------------------------------
# pyanaconda's FlatpakManager hardcodes file:///flatpak/repo, installs every
# app/ ref it finds into the target's /var/lib/flatpak during the installation,
# and skips runtimes (they come in as dependencies). That is what makes the
# Flatpak preinstall offline and finished before the first boot.
COPY flatpak_refs /flatpak_refs
COPY build_files/installer/build-flatpak-repo.sh /usr/libexec/pixel-blue/build-flatpak-repo.sh
RUN /usr/libexec/pixel-blue/build-flatpak-repo.sh \
 && rm -f /usr/libexec/pixel-blue/build-flatpak-repo.sh

# The remote the *installed* system uses afterwards, so updates keep working.
COPY build_files/installer/10-flatpak.conf /etc/anaconda/conf.d/10-flatpak.conf

# --- ISO configuration ------------------------------------------------------
# ISO label, GRUB menu and kernel command line. Only bootc-generic-iso reads
# this file. The label must match inst.stage2=hd:LABEL= inside it.
COPY build_files/installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# What Anaconda installs, and that the result boots to a graphical login.
# Anaconda reads this only because no inst.ks= is passed; it is a kickstart,
# but without the automated flags, so it still asks for whatever is missing.
COPY build_files/installer/interactive-defaults.ks.in /tmp/interactive-defaults.ks.in
RUN sed -e "s|@PAYLOAD_SRC@|${PAYLOAD_SRC_REF}|g" \
        -e "s|@PAYLOAD_TARGET@|${PAYLOAD_TARGET_REF}|g" \
        /tmp/interactive-defaults.ks.in > /usr/share/anaconda/interactive-defaults.ks \
 && rm -f /tmp/interactive-defaults.ks.in

# --- Anaconda runtime -------------------------------------------------------
# The bare minimum lorax normally performs. Without these Anaconda never starts
# from a bootc container: there is no installer user, Anaconda is not the boot
# target, and the initramfs has no anaconda module.

# The installer runs as `install`; its shell is what starts Anaconda.
RUN printf 'u install 0:0 "Anaconda Installer" /root /usr/libexec/anaconda/run-anaconda\n' \
      > /usr/lib/sysusers.d/anaconda.conf \
 && systemd-sysusers anaconda.conf \
 && passwd -d root

# A VT with a pre-logged-in session -- this is what replaces getty and puts the
# installer on screen. No preset ships it, the image has to enable it.
RUN systemctl enable anaconda-shell@tty1.service

# Anaconda owns the machine while it runs.
RUN ln -sf /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
 && rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

# Keep the installer's repositories off the installed system. dnf5 on newer
# bases only ships the /usr/share path.
RUN set -eux; \
    if [ -d /etc/yum.repos.d ]; then \
      mv /etc/yum.repos.d /etc/anaconda.repos.d; \
    else \
      mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d; \
    fi

# Anaconda wants a real /root; on bootc it is a symlink to /var/roothome.
RUN mkdir -p "$(realpath /root)"

# pipewire runs as the installer user, so drop the user-only condition.
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d \
 && printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf \
 && printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf

# The initramfs needs the anaconda module. --no-hostonly because this ISO boots
# on machines other than the one that built it.
RUN kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') \
 && DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
      --add anaconda \
      "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"
