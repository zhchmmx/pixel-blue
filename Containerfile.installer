# Anaconda installer image for the Pixel Blue ISO.
#
# image-builder turns this container into the ISO (bootc-generic-iso): the
# squashfs the installer boots into, plus a copy of the payload container in
# its storage. There is no live desktop here -- this image exists only to run
# Anaconda.
#
#   image-builder build \
#     --bootc-ref localhost/pixel-blue-installer:latest \
#     --bootc-installer-payload-ref localhost/pixel-blue-payload:latest \
#     bootc-generic-iso
#
# Responsibilities, in the order they appear below:
#   * Anaconda's GTK interface, drawn on a kiosk compositor
#   * the ISO's GRUB menu and kernel command line            (iso.yaml)
#   * what gets installed and how it boots afterwards        (interactive-defaults.ks)
#   * /flatpak/repo, the offline Flatpak source Anaconda installs during the run
#   * the glue that lets Anaconda start at all from a container (the lorax part)
#
# Build with:
#   sudo podman build --cap-add sys_admin --security-opt label=disable \
#     --tag localhost/pixel-blue-installer:latest --file Containerfile.installer .
#
# The extra capabilities are for the Flatpak install below (bwrap wants a
# writable /proc/sys).

ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:latest

# Both are baked into interactive-defaults.ks. They are separate because the
# source is a local copy in the installer's own container storage (stripped of
# signatures, see build-disk.yml) while the target is the published reference
# the installed system follows for updates.
ARG PAYLOAD_SRC_REF=ghcr.io/zhchmmx/pixel-blue:latest
ARG PAYLOAD_TARGET_REF=ghcr.io/zhchmmx/pixel-blue:latest

FROM ${BASE_IMAGE}

ARG PAYLOAD_SRC_REF
ARG PAYLOAD_TARGET_REF

# anaconda-install-img-deps is the dependency set for installing *from* an
# image. It brings anaconda-core, gnome-kiosk, the anaconda-shell@ unit, the
# logind ReserveVT drop-in and mesa-dri-drivers -- Anaconda draws its UI inside
# that kiosk session, so without this package there is a backend and a blank
# screen.
#
# anaconda is the metapackage: it resolves anaconda-gui or anaconda-webui from
# the base image's release identity (gui for server/basic/iot, webui
# otherwise). build-disk.yml asserts the webui half never gets pulled in.
#
# xorriso/isomd5sum/grub2-tools/jq are bootc-generic-iso's own requirements
# (xorrisofs, implantisomd5, grub2-mkimage, and the kernel-install JSON parsing
# below). The fonts, plymouth and GPU firmware are what a graphical installer
# needs to draw anything on real hardware.
RUN dnf install -y \
      anaconda-install-img-deps \
      anaconda \
      anaconda-dracut \
      dracut-config-generic \
      dracut-network \
      biosdevname \
      prefixdevname \
      net-tools \
      plymouth \
      default-fonts-core-sans \
      default-fonts-other-sans \
      google-noto-sans-cjk-fonts \
      linux-firmware \
      intel-gpu-firmware \
      mesa-dri-drivers \
      flatpak \
      flatpak-libs \
      xorriso \
      isomd5sum \
      grub2-tools \
      grub2-efi-x64-cdboot \
      'lorax-templates-*' \
      python3-mako \
      squashfs-tools \
      jq \
 && dnf clean all

# lorax wants a symlink in /mnt pointing at /var/mnt, which bootc images do not
# ship.
RUN mkdir -p /var/mnt

# The ISO's ESP is assembled from here.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# --- Flatpak source ---------------------------------------------------------
# pyanaconda's FlatpakManager hardcodes file:///flatpak/repo, installs every
# app/ ref it finds into the target's /var/lib/flatpak during the installation,
# and skips runtimes (they come in as dependencies). That is what makes the
# Flatpak preinstall offline and finished before the first boot.
COPY flatpak_refs /flatpak_refs
COPY build_files/installer/build-flatpak-repo.sh /usr/libexec/pixel-blue/build-flatpak-repo.sh
RUN /usr/libexec/pixel-blue/build-flatpak-repo.sh \
 && rm -f /usr/libexec/pixel-blue/build-flatpak-repo.sh

# The remote the *installed* system uses afterwards, so updates keep working.
COPY build_files/installer/10-flatpak.conf /etc/anaconda/conf.d/10-flatpak.conf

# Anaconda cannot preinstall Flatpaks on a bootc payload at all, and needs two
# small patches before it can. Both are applied by one script so they are
# reviewable and fail loudly when anaconda upstream moves the code:
#
#   1. The bootc branch of RPMOSTreeModule.install_with_tasks() never builds an
#      InstallFlatpaksTask. Only the ostree branch does. A bootc install
#      therefore logs a "Find size of flatpaks" task (the FLATPAK source is
#      registered, so the payload computes its size) and then installs
#      nothing -- measured on a full install.
#   2. InstallFlatpaksTask hands its FlatpakManager no ref list, and on this
#      payload nothing else supplies one: the only caller of
#      set_flatpak_refs() anywhere in pyanaconda is the DNF payload. With an
#      empty list the manager's install() returns at its "no flatpaks are
#      marked for install" guard, silently.
#
# The ref list is /flatpak/refs, derived from the repo build-flatpak-repo.sh
# just produced. This is the same technique the established ISO builders use
# (build-container-installer's lorax templates rewrite these files with
# `replace`); anaconda has no configuration option for either behaviour.
COPY build_files/installer/patch-anaconda-flatpak.py /usr/libexec/pixel-blue/patch-anaconda-flatpak.py
# Run it through python3 rather than relying on the executable bit: this
# repository is developed on Windows, where git does not record file modes
# (core.filemode=false), so a script committed as 100644 arrives here
# non-executable and the build dies with "Permission denied".
RUN python3 /usr/libexec/pixel-blue/patch-anaconda-flatpak.py \
 && rm -f /usr/libexec/pixel-blue/patch-anaconda-flatpak.py

# --- ISO configuration ------------------------------------------------------
# ISO label, GRUB menu and kernel command line. Only bootc-generic-iso reads
# this file. The label must match inst.stage2=hd:LABEL= inside it.
COPY build_files/installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# What Anaconda installs, and that the result boots to a graphical login.
# Anaconda reads this only because no inst.ks= is passed; it is a kickstart,
# but without the automated flags, so it still asks for whatever is missing.
COPY build_files/installer/interactive-defaults.ks.in /tmp/interactive-defaults.ks.in
RUN sed -e "s|@PAYLOAD_SRC@|${PAYLOAD_SRC_REF}|g" \
        -e "s|@PAYLOAD_TARGET@|${PAYLOAD_TARGET_REF}|g" \
        /tmp/interactive-defaults.ks.in > /usr/share/anaconda/interactive-defaults.ks \
 && rm -f /tmp/interactive-defaults.ks.in

# --- Anaconda runtime -------------------------------------------------------
# The bare minimum lorax normally performs. Without these Anaconda never starts
# from a bootc container: there is no installer user, Anaconda is not the boot
# target, and the initramfs has no anaconda module.

# The installer runs as `install`; its shell is what starts Anaconda.
RUN printf 'u install 0:0 "Anaconda Installer" /root /usr/libexec/anaconda/run-anaconda\n' \
      > /usr/lib/sysusers.d/anaconda.conf \
 && systemd-sysusers anaconda.conf \
 && passwd -d root

# Anaconda does not draw its own screen. It hands the UI to a Wayland compositor
# it starts through /usr/libexec/anaconda/run-in-new-session, and that helper
# opens a PAM session for the service named on its command line, which is
# "anaconda". The /etc/pam.d/anaconda that ships with the package covers auth
# and account only -- its session stack has no pam_systemd.so, so logind is
# never told the compositor exists. gnome-kiosk then dies in
# sd_pid_get_session() with "Failed to setup: Failed to find any matching
# session", /run/user/0 is never created, and Anaconda reports "exited on
# signal 1" and falls back to a TUI that has no terminal to draw on.
#
# The same command run by hand works, because the helper's default service
# (su-l) does include pam_systemd. This line is the whole difference.
RUN grep -q pam_systemd /etc/pam.d/anaconda \
 || sed -i '$a session optional pam_systemd.so' /etc/pam.d/anaconda

# Which pages the installation summary shows, and how the target disk is
# partitioned by default, are both decided by matching /etc/os-release against
# /etc/anaconda/profile.d/*.conf. The fallback fedora.conf asks only for
# os_id=fedora and therefore matches everything; the base image ships neither
# VARIANT nor VARIANT_ID, so without a variant the installer drops to that
# generic profile: Time & Date and User Creation spokes that Silverblue
# deliberately leaves to the first boot.
#
# Our profile inherits fedora-silverblue and rewrites one thing -- the default
# partitioning. The Silverblue plan also wants /var and /home btrfs subvolumes,
# and a bootc deployment uses neither: its fstab references only /boot, and
# /var comes from ostree/deploy/<stateroot>/var. Left in the plan, the /var
# subvolume makes PrepareBootcMountTargetsTask bind a mount that was never
# mounted and the payload step dies on it. See pixel-blue.conf for the details.
# VARIANT_ID=pixel-blue matches our profile and nothing upstream.
COPY build_files/installer/pixel-blue.conf /etc/anaconda/profile.d/pixel-blue.conf
RUN printf '\nVARIANT="Pixel Blue"\nVARIANT_ID=pixel-blue\n' >> /usr/lib/os-release

# Anaconda takes the product identity it shows from /.buildstamp first, then
# from the ANACONDA_* environment variables, then from a hardcoded last resort
# inside pyanaconda: product "anaconda", version "bluesky", IsFinal false.
# image-builder writes no buildstamp for bootc-generic-iso, so every level fell
# through and the installer introduced itself as "ANACONDA BLUESKY" with a
# pre-release badge underneath. This is the file lorax normally writes.
#
# Version follows VERSION_ID so it keeps tracking the base image instead of
# being pinned here.
RUN version="$(sed -n 's/^VERSION_ID=//p' /usr/lib/os-release)" \
 && test -n "$version" \
 && printf '[Main]\nProduct=Pixel Blue\nVersion=%s\nIsFinal=True\n' "$version" > /.buildstamp

# Anaconda draws its interface on tty6, and tty6 is exactly the VT systemd
# reserves for autovt@ by default (ReserveVT defaults to 6). "Reserved" means
# logind starts autovt@ on that VT unconditionally -- and with the autovt@
# symlink below that is an agetty shell, which takes the tty before the
# compositor can use it.
#
# Measured on the built ISO: anaconda-shell@tty6 started at 20.5s, Anaconda
# switched to graphical mode at 20.9s, and run-in-new-session was killed by
# SIGHUP (reported as "exited on signal 1") at 21.5s, without the compositor
# ever writing a line. Restarting anaconda minutes later works, because by then
# nothing is holding tty6 any more.
#
# Moving the reserved VT to 2 leaves tty6 uncontended. This is the half of the
# image-builder documentation's recipe that this file used to miss, and it is
# what upstream changed for F46 (rhinstaller/anaconda#7193); the F44 packages
# still default to 6.
RUN mkdir -p /usr/lib/systemd/logind.conf.d \
 && printf '[Login]\nReserveVT=2\n' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

# Take the auto-activated VTs away from getty.
#
# logind spawns autovt@ttyN for every VT it activates, and in the base image
# autovt@ points at getty@, which puts a login prompt on the VT the installer is
# about to draw on. anaconda-shell@ is what the reference installer images use
# there: an already-open shell that hands the VT over instead of a login prompt.
RUN rm -f /usr/lib/systemd/system/autovt@.service \
 && ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

# Anaconda owns the machine while it runs.
RUN ln -sf /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
 && rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

# Keep the installer's repositories off the installed system. dnf5 on newer
# bases only ships the /usr/share path.
RUN set -eux; \
    if [ -d /etc/yum.repos.d ]; then \
      mv /etc/yum.repos.d /etc/anaconda.repos.d; \
    else \
      mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d; \
    fi

# Anaconda wants a real /root; on bootc it is a symlink to /var/roothome.
RUN mkdir -p "$(realpath /root)"

# pipewire runs as the installer user, so drop the user-only condition.
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d \
 && printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf \
 && printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf

# The initramfs needs the anaconda module. --no-hostonly because this ISO boots
# on machines other than the one that built it.
RUN kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') \
 && DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
      --add anaconda \
      "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"
